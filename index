<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>MINI 12V PUMP - 150W - Workshop</title>
  <style>
    * { margin:0; padding:0; box-sizing:border-box; }
    body { font-family: 'Segoe UI', Tahoma, sans-serif; line-height: 1.6; background: #f4f7f6; color: #333; }
    .container { max-width: 600px; margin: 0 auto; background: #fff; min-height: 100vh; box-shadow: 0 0 20px rgba(0,0,0,0.1); }

    header { 
      background: linear-gradient(135deg, #d32f2f, #b71c1c); 
      color: white; 
      text-align: center; 
      padding: 40px 20px; 
    }
    header h1 { 
      font-size: 2.2rem; 
      text-transform: uppercase; 
      margin: 10px 0; 
      font-weight: 800;
      letter-spacing: 1px;
    }
    header p {
      font-size: 0.95rem;
      font-weight: 400;
      opacity: 0.9;
      line-height: 1.4;
    }
    .badge { 
      background: #ffeb3b; 
      color: #d32f2f; 
      padding: 6px 18px; 
      border-radius: 20px; 
      font-weight: bold; 
      font-size: 0.9rem; 
      display: inline-block;
    }

    .carousel-container { position: relative; width: 100%; overflow: hidden; background: #000; height: 350px; }
    .carousel-wrapper { display: flex; transition: transform 0.5s ease-in-out; height: 100%; }
    .carousel-item { min-width: 100%; }
    .carousel-item img { width: 100%; height: 100%; object-fit: cover; }
    .nav-btn { position: absolute; top: 50%; transform: translateY(-50%); background: rgba(0,0,0,0.4); color: white; border: none; padding: 15px 10px; cursor: pointer; z-index: 10; }
    .next { right: 0; }
    .prev { left: 0; }

    .pricing-section { padding: 30px 15px; background: #fff; text-align: center; }
    .pricing-title { color: #d32f2f; margin-bottom: 20px; font-size: 1.4rem; font-weight: bold; }
    .pricing-grid { display: grid; grid-template-columns: 1fr; gap: 15px; }
    .price-card { border: 2px solid #eee; border-radius: 15px; padding: 20px; position: relative; overflow: hidden; }
    .price-card.popular { border-color: #d32f2f; background: #fff8f8; transform: scale(1.02); }
    .price-card.popular::after { content: "RECOMMENDED"; position: absolute; top: 10px; right: -30px; background: #d32f2f; color: white; font-size: 0.7rem; padding: 5px 35px; transform: rotate(45deg); }
    .price-card h4 { font-size: 1.2rem; }
    .price-card .price { font-size: 1.5rem; color: #d32f2f; font-weight: 900; }
    .price-card .gift { font-size: 0.9rem; color: #2e7d32; font-weight: bold; }

    .order-section { padding: 30px 20px; background: #fdfdfd; border-top: 5px solid #d32f2f; }
    label { display: block; margin-top: 15px; font-weight: bold; font-size: 0.9rem; color: #555; }
    input, select { width: 100%; padding: 14px; margin-top: 5px; border: 1px solid #ddd; border-radius: 10px; font-size: 16px; }
    .btn-submit { width: 100%; padding: 20px; background: #d32f2f; color: white; border: none; border-radius: 50px; font-weight: bold; font-size: 1.3rem; margin-top: 30px; cursor: pointer; box-shadow: 0 6px 20px rgba(211,47,47,0.3); }

    footer { background: #2c3e50; color: white; padding: 40px 20px; }
    .shop-info h3 { border-left: 4px solid #ffeb3b; padding-left: 10px; margin-bottom: 15px; }
    .shop-info p { margin-bottom: 10px; font-size: 0.95rem; }
    .trust-badges { display: flex; justify-content: space-around; margin-top: 20px; border-top: 1px solid #555; padding-top: 20px; text-align: center; font-size: 0.8rem; }

    #msg { text-align: center; margin-top: 15px; font-weight: bold; }
  </style>
</head>
<body>

<div class="container">
  <header>
    <span class="badge">MINI 12V PUMP - 150W</span>
    <h1>WORKSHOP</h1>
    <p>NEW SOLUTION - CONVENIENT - EASY INSTALLATION - ENERGY SAVING</p>
  </header>

  <div class="carousel-container">
    <div class="carousel-wrapper" id="carousel">
      <div class="carousel-item"><img src="https://raw.githubusercontent.com/Phamcuong1405/xuongchetao/main/may-1.jpg"></div>
      <div class="carousel-item"><img src="https://raw.githubusercontent.com/Phamcuong1405/xuongchetao/main/may-2.jpg"></div>
      <div class="carousel-item"><img src="https://raw.githubusercontent.com/Phamcuong1405/xuongchetao/main/may3.jpg"></div>
    </div>
    <button class="nav-btn prev" onclick="moveSlide(-1)">&#10094;</button>
    <button class="nav-btn next" onclick="moveSlide(1)">&#10095;</button>
  </div>

  <section class="pricing-section">
    <div class="pricing-title">TODAY'S SPECIAL PRICING</div>
    <div class="pricing-grid">
      <div class="price-card">
        <h4>1 Unit Package</h4>
        <div class="price">250,000 VND</div>
        <p>(Nationwide Shipping Fee: 30,000 VND)</p>
      </div>
      <div class="price-card popular">
        <h4>2 Units Package</h4>
        <div class="price">500,000 VND</div>
        <div class="gift">FREE SHIPPING</div>
      </div>
      <div class="price-card">
        <h4>3 Units Package</h4>
        <div class="price">750,000 VND</div>
        <div class="gift">FREE SHIPPING & 2-MONTH WARRANTY FOR PUMP HEAD</div>
      </div>
    </div>
  </section>

  <section class="order-section" id="dat-hang">
    <h2 style="text-align:center; color:#d32f2f;">ORDER INFORMATION</h2>
    <form id="orderForm">
      <label>Full Name</label>
      <input type="text" name="name" placeholder="Example: Nguyen Van A" required>

      <label>Phone Number</label>
      <input type="tel" name="phone" placeholder="Delivery phone number" required>

      <label>Delivery Address</label>
      <input type="text" name="address" placeholder="House number, street, ward, district, city" required>

      <label>Select Package</label>
      <select name="package">
        <option value="1 unit - 250k">Buy 1 pump - 250,000 VND (Shipping: 30,000 VND nationwide)</option>
        <option value="2 units - 500k">Buy 2 pumps - 500,000 VND (Free shipping)</option>
        <option value="3 units - 750k">Buy 3 pumps - 750,000 VND (Free shipping & 2-month warranty)</option>
      </select>

      <label>Additional Notes</label>
      <input type="text" name="note" placeholder="Extra requests (if any)">

      <button type="submit" id="btnSubmit" class="btn-submit">CONFIRM ORDER</button>
    </form>
    <div id="msg"></div>
  </section>

  <footer>
    <div class="shop-info">
      <h3>CONTACT INFORMATION</h3>
      <p>🏠 <strong>Address:</strong> Workshop, Linh Nam, Hanoi</p>
      <p>📞 <strong>Hotline/Zalo:</strong> 0886 073 622</p>
      <p>⏰ <strong>Working Hours:</strong> 08:00 - 21:00 (Daily)</p>
      <p>🛡️ <strong>Warranty:</strong> 1-for-1 exchange within 7 days if defective</p>
    </div>
    <div class="trust-badges">
      <div>🚚<br>Nationwide Delivery</div>
      <div>📦<br>Check Before Payment</div>
      <div>⭐<br>Top Quality</div>
    </div>
  </footer>
</div>

<script>
  let currentIndex = 0;
  const slides = document.getElementById('carousel');
  function moveSlide(step) {
    currentIndex = (currentIndex + step + 3) % 3;
    slides.style.transform = `translateX(-${currentIndex * 100}%)`;
  }
  setInterval(() => moveSlide(1), 5000);

  const WEB_APP_URL = "https://script.google.com/macros/s/AKfycbyC9ZqEzpvd-q1afHQvO1hboWUeaRyyW_0Uo0a3rwZO4IQVQbXqP0y3syIYfQzpfo88jQ/exec";

  document.getElementById("orderForm").addEventListener("submit", function(e) {
    e.preventDefault();
    const btn = document.getElementById("btnSubmit");
    const msg = document.getElementById("msg");

    if (btn.disabled) return;
    btn.disabled = true;
    btn.innerText = "PROCESSING...";

    const params = new URLSearchParams({
      name: this.name.value,
      phone: this.phone.value,
      address: this.address.value,
      package: this.package.value,
      note: this.note.value,
      source: "LandingPage-Pro"
    });

    const finalUrl = WEB_APP_URL + "?" + params.toString();
    
    const img = new Image();
    img.src = finalUrl;

    setTimeout(() => {
      msg.style.color = "green";
      msg.innerHTML = "✅ ORDER SUCCESSFUL! <br> We will contact you shortly.";
      this.reset();
      btn.disabled = false;
      btn.innerText = "ORDER MORE";
    }, 1500);
  });
</script>
</body>
</html>
